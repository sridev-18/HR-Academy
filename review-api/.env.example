# Django Review API Configuration
DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,hr-square-reviews.onrender.com

# Database (PostgreSQL)
DB_NAME=hr_square_reviews
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Production Database URL (Optional - e.g. for Render PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/hr_square_reviews

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://hr-square-academy.onrender.com,https://hrsquareacademy.in
